# Copy this to .env and fill in your values. NEVER commit .env.

# Anthropic (required for LLM estimation)
ANTHROPIC_API_KEY=sk-ant-...

# Polymarket wallet (only required for live trading — Phase 7)
# Your Polygon private key (hex, without 0x prefix)
PK=
# Proxy/funder wallet address (if using Polymarket email/browser wallet)
# This is the address that holds your USDC on Polymarket
FUNDER=

# Paper trading config
BANKROLL_USDC=500.0

# ---- Tunable thresholds (all have defaults in config.py; override here if desired) ----
# MIN_LIQUIDITY=2000
# MIN_VOLUME=10000
# MIN_EDGE=0.08
# MIN_CONFIDENCE=0.6
# MIN_DAYS_TO_RESOLVE=2
# MAX_DAYS_TO_RESOLVE=60
# KELLY_FRACTION=0.25
# MAX_POSITION_FRAC=0.05
# MAX_TOTAL_EXPOSURE=0.5
