# Copy to .env and fill in real values. NEVER commit .env.

# Tailscale auth key — https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=

# Pi-hole web UI password (also used by the dashboard)
PIHOLE_WEBPASSWORD=

# Nextcloud
NEXTCLOUD_DB_ROOT_PASSWORD=
NEXTCLOUD_DB_PASSWORD=
NEXTCLOUD_ADMIN_PASSWORD=

# Immich (used by both the server and its Postgres)
IMMICH_DB_PASSWORD=

# Open WebUI session signing key (any long random string)
OPEN_WEBUI_SECRET_KEY=

# Grafana admin
GRAFANA_ADMIN_PASSWORD=

# Portainer admin password as a bcrypt hash (only applied on first start).
# Generate: docker run --rm httpd:2 htpasswd -nbB admin 'YOURPASSWORD' | cut -d: -f2
PORTAINER_ADMIN_PASSWORD_HASH=

# API keys for the dashboard's download-queue view (Settings > General in each app)
RADARR_API_KEY=
SONARR_API_KEY=
LIDARR_API_KEY=
